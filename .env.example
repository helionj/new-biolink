# ============================================================
# BioLink — Environment Variables (template)
# ============================================================
# Copy to .env.local for local dev or .env.test for tests.
# NEVER commit .env.local with real secrets — they go to Vercel
# and GitHub Actions secrets only.
# ============================================================

# --------------------------------------------
# Supabase (Story 1.2)
# --------------------------------------------
# Project URL and anon key are public (safe in NEXT_PUBLIC_*).
# Service-role key is SERVER-ONLY — never expose client-side.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Base URL absoluta — ex: http://localhost:3000 em dev,
# https://<preview>.vercel.app em preview, https://new-biolink.vercel.app em prod.
# Consumido por redirectTo de emails Supabase Auth (Story 1.6).
NEXT_PUBLIC_SITE_URL=

# --------------------------------------------
# PII Hashing (Story 4.1)
# --------------------------------------------
# Salt for one-way hashing of PII (visitor identifiers etc.).
# Generate with: openssl rand -hex 32
HASH_SALT=

# ============================================================
# AIOX agent tooling (optional — local dev only)
# ============================================================
# Below are LLM/tool keys consumed by the AIOX agent harness
# during development. Not used by the BioLink app at runtime.
# ============================================================

# --------------------------------------------
# LLM Providers
# --------------------------------------------
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --------------------------------------------
# Search & Research
# --------------------------------------------
EXA_API_KEY=
CONTEXT7_API_KEY=

# --------------------------------------------
# Version Control & Deploy
# --------------------------------------------
GITHUB_TOKEN=
VERCEL_TOKEN=
RAILWAY_TOKEN=

# --------------------------------------------
# Project Management & Automation
# --------------------------------------------
CLICKUP_API_KEY=
N8N_API_KEY=
N8N_WEBHOOK_URL=

# --------------------------------------------
# Monitoring
# --------------------------------------------
SENTRY_DSN=

# --------------------------------------------
# Runtime
# --------------------------------------------
NODE_ENV=development
AIOX_VERSION=2.2.0
